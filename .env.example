# --- DATABASE (PostgreSQL) ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane_password
POSTGRES_DB=plane_db
# Dùng cho Plane API kết nối tới DB
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- CACHE (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- PLANE APPLICATION ---
# Secret key dùng cho Django, sinh bằng: openssl rand -hex 32
SECRET_KEY=PLACEHOLDER_CHANGE_ME_IN_PRODUCTION
PLANE_DOMAIN=plane.example.com
NEXT_PUBLIC_API_BASE_URL=https://plane.example.com

# Storage (MinIO — OSS, bắt buộc cho file upload)
USE_MINIO=1
STORAGE_TYPE=minio
AWS_ACCESS_KEY_ID=minioaccess
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=us-east-1
# Kết nối nội bộ backend → MinIO (presigned URL tự dùng request.get_host())
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
MINIO_ENDPOINT_SSL=0

# Traefik / SSL
SSL_EMAIL=admin@example.com

# Optional: OAuth (Social Login)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=

# --- DOCKER IMAGES (Plane v1.3.0) ---
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine
PLANE_WEB_IMAGE=makeplane/plane-frontend:v1.3.0
PLANE_API_IMAGE=makeplane/plane-backend:v1.3.0
PLANE_WORKER_IMAGE=makeplane/plane-backend:v1.3.0
PLANE_SPACE_IMAGE=makeplane/plane-space:v1.3.0
PLANE_LIVE_IMAGE=makeplane/plane-live:v1.3.0
PLANE_ADMIN_IMAGE=makeplane/plane-admin:v1.3.0
