# Global Config
DOMAIN=local.test
TZ=Asia/Ho_Chi_Minh
COMPOSE_PROJECT_NAME=platform
STACK_NAME=platform

# Traefik
TRAEFIK_EMAIL=admin@local.test

# Database (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongPostgresPassword123
POSTGRES_DB=postgres

# Authentik
AUTHENTIK_SECRET_KEY=ReplaceWithLongRandomString123!
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Database for Authentik
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=AuthentikPass123!

# NocoBase
NOCOBASE_APP_KEY=ReplaceWithLongRandomKeyHere456!
NOCOBASE_ADMIN_EMAIL=admin@nocobase.com
NOCOBASE_ADMIN_PASSWORD=nocobase
# Database for NocoBase
NOCOBASE_POSTGRES_DB=nocobase
NOCOBASE_POSTGRES_USER=nocobase
NOCOBASE_POSTGRES_PASSWORD=NocoBasePass123!
