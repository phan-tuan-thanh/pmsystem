# Global Config
DOMAIN=local.test
TZ=Asia/Ho_Chi_Minh
COMPOSE_PROJECT_NAME=platform
STACK_NAME=platform

# Traefik
TRAEFIK_EMAIL=admin@local.test

# Database (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongPostgresPassword123
POSTGRES_DB=postgres

# Authentik
AUTHENTIK_SECRET_KEY=ReplaceWithLongRandomString123!
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Database for Authentik
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=AuthentikPass123!

# Plane CE
PLANE_POSTGRES_DB=plane_ce
PLANE_POSTGRES_USER=plane_ce
PLANE_POSTGRES_PASSWORD=PlanePass123!
PLANE_SECRET_KEY=ReplaceWithLongRandomKeyForPlane789!
PLANE_ADMIN_EMAIL=admin@plane.local
PLANE_ADMIN_PASSWORD=PlaneAdmin123!

# AWS S3 / MinIO (for file uploads in Plane CE)
AWS_S3_BUCKET_NAME=plane-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://platform-minio:9000
AWS_S3_REGION_NAME=us-east-1

# Email/SMTP (optional, for Plane CE notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=noreply@plane.local
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@plane.local

# Plane AI Service
PLANE_AI_SERVICE_TOKEN=test-token-for-development
PLANE_AI_DB=plane_ai
PLANE_AI_POSTGRES_USER=plane_ai
PLANE_AI_POSTGRES_PASSWORD=PlaneAIPass123!
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
